    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-query-devtools": "^5.17.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "expo": "^50.0.0",
    "expo-av": "^13.10.0",
